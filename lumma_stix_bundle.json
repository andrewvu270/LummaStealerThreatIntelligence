      "created": "2025-03-01T00:00:00.000Z",
      "modified": "2025-03-28T00:00:00.000Z",
      "name": "Process Injection Target: RegSvcs.exe",
      "description": "Lumma Stealer injects its payload into RegSvcs.exe (a legitimate signed Windows binary) to disguise malicious activity.",
      "indicator_types": ["malicious-activity"],
      "pattern": "[process:name = 'RegSvcs.exe' AND process:is_hidden = true]",
      "pattern_type": "stix",
      "valid_from": "2024-01-01T00:00:00.000Z",
