    {
      "type": "malware",
      "spec_version": "2.1",
      "id": "malware--lumma-0001-4eee-aaaa-lummac2v2025",
      "created": "2025-03-01T00:00:00.000Z",
      "modified": "2025-03-28T00:00:00.000Z",
      "name": "Lumma Stealer",
      "description": "Lumma Stealer (also known as LummaC2) is a Malware-as-a-Service information stealer first observed in August 2022. Developed by threat actor 'Shamel', it targets Windows systems (7-11) and steals browser credentials, session cookies, cryptocurrency wallets, and 2FA extension data. Delivered via ClickFix fake CAPTCHA, cracked software, and phishing. Active globally as of 2025.",
      "malware_types": ["infostealer"],
      "is_family": false,
      "aliases": ["LummaC2", "LummaC", "Lumma"],
      "kill_chain_phases": [
        { "kill_chain_name": "mitre-attack", "phase_name": "initial-access" },
        { "kill_chain_name": "mitre-attack", "phase_name": "execution" },
        { "kill_chain_name": "mitre-attack", "phase_name": "defense-evasion" },
        { "kill_chain_name": "mitre-attack", "phase_name": "credential-access" },
        { "kill_chain_name": "mitre-attack", "phase_name": "collection" },
        { "kill_chain_name": "mitre-attack", "phase_name": "exfiltration" }
      ],
      "first_seen": "2022-08-01T00:00:00.000Z",
      "last_seen": "2025-05-22T00:00:00.000Z",
      "operating_system_refs": [],
      "external_references": [
        { "source_name": "CISA", "url": "https://www.cisa.gov/news-events/cybersecurity-advisories/aa25-141b", "description": "CISA Advisory AA25-141B" },
        { "source_name": "MITRE ATT&CK", "url": "https://attack.mitre.org/software/S1213/", "external_id": "S1213" }
      ]
    },

    {
      "type": "threat-actor",
      "spec_version": "2.1",
      "id": "threat-actor--shamel-0001-lumma-dev-2022",
      "created": "2025-03-01T00:00:00.000Z",
      "modified": "2025-03-28T00:00:00.000Z",
      "name": "Shamel",
      "description": "Threat actor operating under aliases 'Shamel' and 'Lumma'. Developer and operator of the Lumma Stealer MaaS platform. Active on Russian-speaking cybercrime forums since 2022. Financially motivated.",
      "aliases": ["Lumma", "Shamel"],
      "threat_actor_types": ["criminal"],
      "sophistication": "expert",
      "primary_motivation": "financial-gain",
      "external_references": [
        { "source_name": "ConnectWise CRU", "description": "ConnectWise Monthly Threat Brief, January 2025" }
      ]
    },

    {
      "type": "indicator",
      "spec_version": "2.1",
      "id": "indicator--net-001-teslabrowser-ua",
      "created": "2025-03-01T00:00:00.000Z",
      "modified": "2025-03-28T00:00:00.000Z",
      "name": "Lumma C2 User-Agent: TeslaBrowser/5.5",
      "description": "HTTP POST requests using User-Agent 'TeslaBrowser/5.5' are characteristic of Lumma Stealer C2 communications.",
      "indicator_types": ["malicious-activity", "network-traffic"],
      "pattern": "[network-traffic:extensions.'http-request-ext'.request_header.'User-Agent' = 'TeslaBrowser/5.5']",
      "pattern_type": "stix",
      "valid_from": "2022-08-01T00:00:00.000Z",
      "external_references": [
        { "source_name": "ConnectWise CRU", "description": "ConnectWise Threat Brief Jan 2025" },
        { "source_name": "CISA AA25-141B", "url": "https://www.cisa.gov/news-events/cybersecurity-advisories/aa25-141b" }
      ]
    },

    {
      "type": "indicator",
      "spec_version": "2.1",
      "id": "indicator--hash-001-crowdstrike-2024",
      "created": "2025-03-01T00:00:00.000Z",
      "modified": "2025-03-28T00:00:00.000Z",
      "name": "Lumma Stealer SHA-256 — CrowdStrike Campaign (2024-07-19)",
      "description": "Lumma Stealer sample RC4-encrypted with key 656505, LZNT1-compressed. Observed in CrowdStrike-themed phishing campaign following July 2024 sensor content issue.",
      "indicator_types": ["malicious-activity"],
      "pattern": "[file:hashes.'SHA-256' = 'd669078a7cdcf71fb3f2c077d43f7f9c9fdbdb9af6f4d454d23a718c6286302a']",
      "pattern_type": "stix",
      "valid_from": "2024-07-19T00:00:00.000Z",
      "external_references": [
        { "source_name": "CrowdStrike", "url": "https://www.crowdstrike.com/en-us/blog/lumma-stealer-with-cypherit-phishing-lure/", "description": "CrowdStrike Lumma+CypherIt campaign analysis" }
      ]
    },

