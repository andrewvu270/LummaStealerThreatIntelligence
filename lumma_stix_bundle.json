    {
      "type": "indicator",
      "spec_version": "2.1",
      "id": "indicator--registry-001-run-key",
      "created": "2025-03-01T00:00:00.000Z",
      "modified": "2025-03-28T00:00:00.000Z",
      "name": "Registry Run Key Persistence",
      "description": "Lumma Stealer creates persistence via HKCU Run registry key. Modification of this key by non-administrative processes is anomalous.",
      "indicator_types": ["malicious-activity"],
      "pattern": "[windows-registry-key:key = 'HKEY_CURRENT_USER\\\\Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Run']",
      "pattern_type": "stix",
      "valid_from": "2022-08-01T00:00:00.000Z",
      "external_references": [{ "source_name": "AttackIQ", "url": "https://www.attackiq.com/2024/10/15/emulating-lumma-stealer/" }]
    },

